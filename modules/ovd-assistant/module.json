  "locales": {
    "en": {
      "title": "OVD Assistant",
      "description": "Manage chats, drafts, references, tasks, windows, time, calculations, the OVD-Bar, settings, interface language, diagnostics and module repositories. Rephrase a reply or continue a saved task.",
      "keywords": ["assistant", "settings", "language", "appearance", "preferences", "German", "English", "save", "retry", "storage", "recovery", "chat", "history", "diagnostics", "tools", "modules", "bar", "dock", "navigation", "order", "reference", "window", "task", "status", "audit", "context", "time", "clock", "date", "timezone", "today", "range", "calculate", "limits", "budget", "repository", "catalog", "install", "update", "notice", "notification", "event", "logging", "provider", "model", "voice", "microphone", "transcription", "dictation"],
      "tools": {
        "settings.get": {
          "label": "Read workspace settings",
          "description": "Read display and OVD-Bar settings, including the saved interface language and resolved locale."
        },
        "settings.update": {
          "label": "Update workspace settings",
          "description": "Change interface language (system, de or en), text size, diagnostics or OVD-Bar settings. Changes apply immediately across windows and persist after restart. Use navigation.move to reposition a single entry."
        },
        "workspace.save_status": {
          "label": "Check save status",
          "description": "Read the current workspace save status, acknowledged revision and any save error."
        },
        "workspace.retry_save": {
          "label": "Retry saving",
          "description": "Retry saving pending workspace changes and report the acknowledged result. This does not repeat prior Assistant actions."
        }
      }
    }
  },
  "required": true,
  "capabilities": [
